# Copy to .env and fill in, or export these in your shell profile.
# .env is gitignored; never commit real keys.

# Free key: https://www.govinfo.gov/api-signup
# Rate limit: 36,000/hr. DEMO_KEY works but is only 10/hr.
GOVINFO_API_KEY=your-key-here

# Free key: https://api.congress.gov/sign-up/
# Rate limit: 5,000/hr. NOT READ YET -- nothing in the pipeline uses this. It is
# what /house-vote will need for phase 8, roll-call votes, which is planned and
# not built; everything fetched today comes from govinfo.
CONGRESS_API_KEY=

# Only for `uscongress update --publish`, which fetches and pushes the generated
# repositories. Needs access to the junxit org; the built-in Actions token cannot
# push to a repository other than its own. Local runs do not need it.
GITHUB_TOKEN=
