# Copy to .env and fill in, or export these in your shell profile.
# .env is gitignored; never commit real keys.

# Free key: https://www.govinfo.gov/api-signup
# Rate limit: 36,000/hr. DEMO_KEY works but is only 10/hr.
GOVINFO_API_KEY=your-key-here

# NOT READ, AND NOT NEEDED. This slot used to be reserved for phase 8, roll-call
# votes, on the assumption that Congress.gov was where votes came from. It is not:
# its /house-vote endpoint covers "all House roll call votes in the 118th and
# 119th Congresses associated with a piece of legislation" and it publishes no
# Senate vote endpoint at all, against a corpus that runs from the 108th and holds
# both chambers -- 2 of 12 Congresses and 1 of 2 chambers.
#
# Votes are fetched from the chambers instead, at clerk.house.gov and senate.gov.
# Neither is keyed, so phase 8 shipped without adding a credential. Kept here as
# the record of a dead end, so nobody reserves it again.
# CONGRESS_API_KEY=

# Only for `uscongress update --publish`, which fetches and pushes the generated
# repositories. Needs access to the junxit org; the built-in Actions token cannot
# push to a repository other than its own. Local runs do not need it.
GITHUB_TOKEN=
